export struct MenuItemData {
    id: string,
    label: string,
    shortcut: string,
    has_submenu: bool,
    icon: string,
}

component MenuItemView inherits Rectangle {
    in property <MenuItemData> item;
    in property <bool> is_selected: false;
    callback clicked();

    height: 42px;
    border-radius: 6px;
    background: is_selected ? #313244 : transparent;

    accessible-role: button;
    accessible-label: item.has_submenu ? item.label + ", submenu" : (item.shortcut != "" ? item.label + ", " + item.shortcut : item.label);

    TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Text {
                text: root.item.icon;
                font-size: 14px;
                vertical-alignment: center;
                color: #cdd6f4;
            }

            Text {
                text: root.item.label;
                font-size: 14px;
                font-weight: root.is_selected ? 600 : 400;
                vertical-alignment: center;
                color: root.is_selected ? #89b4fa : #cdd6f4;
            }
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            if root.item.shortcut != "": Text {
                text: root.item.shortcut;
                font-size: 11px;
                color: #a6adc8;
                vertical-alignment: center;
            }

            if root.item.has_submenu: Text {
                text: "▶";
                font-size: 10px;
                color: root.is_selected ? #89b4fa : #6c7086;
                vertical-alignment: center;
            }
        }
    }
}

export component MenuWindow inherits Window {
    title: "bit_sr Menu";
    width: 320px;
    height: 380px;
    background: #181825;
    always-on-top: true;
    no-frame: true;

    in-out property <[MenuItemData]> items: [
        { id: "pref", label: "Preferences", shortcut: "", has_submenu: true, icon: "⚙️" },
        { id: "tools", label: "Tools", shortcut: "", has_submenu: true, icon: "🛠️" },
        { id: "speech_mode", label: "Speech Mode", shortcut: "", has_submenu: true, icon: "🔊" },
        { id: "help", label: "Help", shortcut: "", has_submenu: true, icon: "❓" },
        { id: "restart", label: "Restart bit_sr", shortcut: "", has_submenu: false, icon: "🔄" },
        { id: "exit", label: "Exit bit_sr", shortcut: "SR + Q", has_submenu: false, icon: "🚪" },
    ];

    in-out property <int> selected_index: 0;
    in-out property <string> current_menu_title: "bit_sr";
    in-out property <bool> is_submenu: false;

    callback item_activated(string /* id */);
    callback submenu_opened(string /* id */);
    callback back_requested();
    callback close_requested();

    forward-focus: fs;

    fs := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                if (root.selected_index > 0) {
                    root.selected_index -= 1;
                } else {
                    root.selected_index = root.items.length - 1;
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.selected_index < root.items.length - 1) {
                    root.selected_index += 1;
                } else {
                    root.selected_index = 0;
                }
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                if (root.items[root.selected_index].has_submenu) {
                    root.submenu_opened(root.items[root.selected_index].id);
                } else {
                    root.item_activated(root.items[root.selected_index].id);
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (root.items[root.selected_index].has_submenu) {
                    root.submenu_opened(root.items[root.selected_index].id);
                    return accept;
                }
            }
            if (event.text == Key.LeftArrow) {
                if (root.is_submenu) {
                    root.back_requested();
                    return accept;
                }
            }
            if (event.text == Key.Escape) {
                if (root.is_submenu) {
                    root.back_requested();
                } else {
                    root.close_requested();
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            // Header
            Rectangle {
                height: 36px;
                background: #1e1e2e;
                border-radius: 6px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    if root.is_submenu: TouchArea {
                        width: 24px;
                        clicked => { root.back_requested(); }
                        Text {
                            text: "◀";
                            font-size: 13px;
                            color: #89b4fa;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.current_menu_title;
                        font-size: 13px;
                        font-weight: 700;
                        color: #89b4fa;
                        vertical-alignment: center;
                    }
                }
            }

            // Menu Items List
            for item[idx] in root.items: MenuItemView {
                item: item;
                is_selected: root.selected_index == idx;
                clicked => {
                    root.selected_index = idx;
                    if (item.has_submenu) {
                        root.submenu_opened(item.id);
                    } else {
                        root.item_activated(item.id);
                    }
                }
            }
        }
    }
}
